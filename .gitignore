# ==============================================================================
# StockPilot - root ignore rules
# Applies to the whole monorepo (backend + frontend + tooling).
# ==============================================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
DEPLOYMENT_CREDENTIALS.txt
secrets.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# Local databases
*.db
*.sqlite
*.sqlite3

# Alembic runtime
alembic/versions/__pycache__/

# ---------- Node / Next.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
build/
.swc/
*.tsbuildinfo
next-env.d.ts

# ---------- Test / build caches (frontend) ----------
coverage/
.nyc_output/
vitest-report/

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log
logs/

# ---------- Uploads (runtime user content) ----------
backend/uploads/products/*
!backend/uploads/products/.gitkeep

# Allow logo uploads to be tracked (needed for product branding)
uploads/logos/
backend/uploads/logos/