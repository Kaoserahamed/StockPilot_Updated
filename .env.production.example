# Production Environment Variables for Docker Compose
# Copy this to .env.production and fill with actual values
# DO NOT commit the actual .env.production file!

# PostgreSQL Database
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=  # REQUIRED: Generate with: openssl rand -base64 32

# Backend Configuration
SECRET_KEY=  # REQUIRED: Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
