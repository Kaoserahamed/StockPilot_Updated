# =============================================================================
# StockPilot Frontend - environment template
#
#   cp .env.example .env.local      then set NEXT_PUBLIC_API_URL below.
#
# NOTE: variables prefixed with NEXT_PUBLIC_ are INLINED INTO THE BROWSER
# BUNDLE at build time. Never put secrets in this file.
# =============================================================================

# Base URL of the StockPilot backend API, reachable from the browser.
#
#   Local development ...... http://localhost:8000
#   Docker compose (dev) ... http://localhost:8000
#   Staging/production ..... https://api.your-domain.example  (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000
